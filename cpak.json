{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v2.json",
  "manifest_version": "2.0",
  "name": "Node LTS SDK",
  "description": "Node.js tools for cpak development environments.",
  "version": "24.19.0",
  "image": "ghcr.io/containerpak/sdk-node-lts:main",
  "binaries": [
    "/usr/local/bin/node",
    "/usr/local/bin/npm",
    "/usr/local/bin/npx",
    "/usr/local/bin/corepack"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "network": true
  }
}
