{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Node LTS SDK",
  "description": "Node.js tools for cpak development environments.",
  "version": "24.20.0",
  "image": "ghcr.io/containerpak/sdk-node-lts@sha256:12efc55363cea479e990ca62c90be3373b0a4388a5ad83ee7f8ad5f8ace6639a",
  "binaries": [
    "/usr/local/bin/node",
    "/usr/local/bin/npm",
    "/usr/local/bin/npx",
    "/usr/local/bin/corepack"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "node-lts",
    "slot": "sdk.node",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/usr/local/bin"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filePicker": {},
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ]
  }
}
